# Hunyuan3D 2.1 runner configuration.
# Copy to .env (install.ps1 does this for you). Absolute paths only.

HUNYUAN3D_SHAPE_REPO=__REPO__
HUNYUAN3D_MODELS_DIR=__WEIGHTS__
HUNYUAN3D_MODEL_ID=tencent/Hunyuan3D-2.1

HUNYUAN3D_MC_RESOLUTION=384
HUNYUAN3D_SHAPE_STEPS=30
HUNYUAN3D_GUIDANCE_SCALE=5.0

# Heads computed at once by the replacement attention. Measured best on gfx1151:
# 4 gives 302 s / 11.6 GB; 8 is 235 s but 17.7 GB; 16 is worse on both counts.
HUNYUAN3D_ATTN_HEAD_CHUNK=4

# **Do not turn this off.** See the note on rembg in requirements.txt.
HUNYUAN3D_REMBG=on
HUNYUAN3D_REMBG_MODEL=isnet-general-use

# Set TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 before torch is imported.
# Measured on gfx1151: flash attention becomes available and the DiT is 5x
# faster than the fp32 head-chunk fallback. No effect if set after import.
HUNYUAN3D_FAST_ATTENTION=on

# Prefer hipBLASLt over rocBLAS (set before torch is imported). Measured on
# gfx1151, ROCm 7.2.1: the DiT's unbiased projections run ~24% faster; one
# generation went 82.6 s to 80.4 s. metrics.blas_backend records which backend
# was in effect.
HUNYUAN3D_PREFER_HIPBLASLT=on

# Keep a hidden render loop alive while generating (gfxlight.py). Measured
# 2026-09-02: no effect in any state - with the display off the GPU pins at
# 600 MHz with the loop alive (see gfx1151-gemm docs/displayoff.md; keeping
# the display awake is what works). Kept only as an experiment switch.
# metrics.gfx_keepalive records whether it was alive.
HUNYUAN3D_GFX_KEEPALIVE=on

# Dedicated VRAM is 32 GB; mem_get_info reports 43.87 GB because it counts
# shared memory. Spilling is silent and slow, so the cap is given to torch too.
HUNYUAN3D_VRAM_LIMIT_GB=30
HUNYUAN3D_HEARTBEAT_SEC=10

# --- Texture stage (install.ps1 -Texture) ------------------------------------
# Unused unless texture_mesh is called, or image_to_mesh is given texture: true.
HUNYUAN3D_TEXTURE_MAX_VIEWS=6
HUNYUAN3D_TEXTURE_VIEW_RESOLUTION=512
HUNYUAN3D_TEXTURE_RENDER_SIZE=2048
HUNYUAN3D_TEXTURE_SIZE=4096

# Where the weights sit. **Upstream goes to the hub even when they are local**,
# and unauthenticated downloads stall at zero bytes here, so it is pointed back
# at these. Keep the sub-folder equal to the name upstream joins on.
HUNYUAN3D_TEXTURE_SUBFOLDER=hunyuan3d-paintpbr-v2-1
# DINOv2 conditions the multi-view diffusion; upstream hardcodes use_dino=True.
HUNYUAN3D_TEXTURE_DINO_DIR=__WEIGHTS__\facebook\dinov2-giant
